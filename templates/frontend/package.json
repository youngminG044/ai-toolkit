{
  "name": "workspace-ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "test": "node --test src/domain.test.mjs",
    "preview": "vite preview --host 0.0.0.0",
